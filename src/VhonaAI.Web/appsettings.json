    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/vhonaai.db",
    "AzureSql": ""
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "App_Data/uploads",
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "csv-uploads"
    },
    "DataProtection": {
      "ContainerName": "vhona-keys"
    }
  },
  "Auth": {
    "Provider": "Demo",
    "DefaultOrganizationName": "",
    "InternalAdminEmails": "",
    "VhonaAdminEmails": "",
    "VhonaAdminObjectIds": "",
    "EntraExternalId": {
      "Instance": "https://<tenant-subdomain>.ciamlogin.com/",
      "Domain": "<tenant-subdomain>.onmicrosoft.com",
      "TenantId": "<TODO-entra-external-id-tenant-id>",
      "ClientId": "<TODO-app-registration-client-id>",
      "ClientSecret": "",
