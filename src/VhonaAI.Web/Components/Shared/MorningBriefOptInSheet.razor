@if (Preference.ShowOptInSheet)
{
    <aside class="brief-sheet" role="dialog" aria-labelledby="brief-sheet-title" aria-describedby="brief-sheet-lede">
        <p class="eyebrow">Morning brief</p>
        <h2 id="brief-sheet-title">@MorningBriefMessages.SheetTitle</h2>
        <p id="brief-sheet-lede" class="lede">@MorningBriefMessages.SheetLede</p>
        <div class="actions brief-sheet-actions">
            <button class="btn btn-primary btn-lg" type="button" @onclick="OptInAsync" disabled="@busy">
                @MorningBriefMessages.Cta
            </button>
            <button class="btn btn-outline" type="button" @onclick="DismissAsync" disabled="@busy">
                @MorningBriefMessages.Dismiss
            </button>
        </div>
    </aside>
}
else if (Preference.OptedIn && ShowConfirmation)
{
    <aside class="brief-sheet is-confirmed" role="status">
        <p class="eyebrow">Morning brief</p>
        <p class="lede">@MorningBriefMessages.OptedIn</p>
        <div class="actions">
            <a class="btn btn-primary" href="/brief">@MorningBriefMessages.SeeBrief</a>
        </div>
    </aside>
}

@code {
    [Parameter, EditorRequired] public MorningBriefPreferenceState Preference { get; set; } = new();
    [Parameter] public EventCallback<MorningBriefPreferenceState> PreferenceChanged { get; set; }
    [Parameter] public bool ShowConfirmation { get; set; }

    [Inject] public MorningBriefService Briefs { get; set; } = default!;

    private bool busy;

    private async Task OptInAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Briefs.OptInAsync();
            await PreferenceChanged.InvokeAsync(result.Preference);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DismissAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var preference = await Briefs.DismissAsync();
            await PreferenceChanged.InvokeAsync(preference);
        }
        finally
        {
            busy = false;
        }
    }
}
