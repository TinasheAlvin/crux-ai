@page "/"
@attribute [Authorize]
@inject IImportAppService Imports
@inject IHealthKpiAppService HealthKpis
@inject IMorningBriefAppService Briefs
@inject NavigationManager Navigation
@inject ICurrentUser CurrentUser
@inject IWebHostEnvironment HostEnvironment

<PageTitle>Home · Vhona AI</PageTitle>

@if (briefLanding is { OptedIn: true })
{
    <p class="eyebrow">@CurrentUser.OrganizationName</p>
    <MorningBriefView Landing="briefLanding" />

    <section class="panel">
        <header class="panel-header">
            <h2>Bring in another file</h2>
            <p>You can map the columns again. Earlier imports stay as they are.</p>
        </header>
        <label class="upload-button @(busy ? "is-disabled" : null)">
            <InputFile OnChange="OnTransactionsSelected" accept=".csv,.xlsx,text/csv" disabled="@busy" />
            @(busy ? "Uploading…" : "Upload transactions")
        </label>
        <label class="upload-button @(busy ? "is-disabled" : null)">
            <InputFile OnChange="OnInvoicesSelected" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@busy" />
            @(busy ? "Uploading…" : "Upload invoices")
        </label>
        <button type="button" class="btn btn-outline sample-btn" @onclick="() => UseSampleAsync(false)" disabled="@busy">
            Use sample CSV
        </button>
        <button type="button" class="btn btn-outline sample-btn" @onclick="() => UseSampleAsync(true)" disabled="@busy">
            Sample with cash
        </button>
        <button type="button" class="btn btn-outline sample-btn" @onclick='() => UseSampleFileAsync("sample-transactions-clean.csv")' disabled="@busy">
            Clean sample
        </button>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <p class="banner banner-error" role="alert">@error</p>
        }
    </section>
}
else if (snapshot?.HasData == true)
{
    <p class="eyebrow">@CurrentUser.OrganizationName</p>
    <HealthKpiCards Snapshot="snapshot" />

    <section class="panel">
        <header class="panel-header">
            <h2>Bring in another file</h2>
            <p>You can map the columns again. Earlier imports stay as they are.</p>
        </header>
        <label class="upload-button @(busy ? "is-disabled" : null)">
            <InputFile OnChange="OnTransactionsSelected" accept=".csv,.xlsx,text/csv" disabled="@busy" />
            @(busy ? "Uploading…" : "Upload transactions")
        </label>
        <label class="upload-button @(busy ? "is-disabled" : null)">
            <InputFile OnChange="OnInvoicesSelected" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@busy" />
            @(busy ? "Uploading…" : "Upload invoices")
        </label>
        <button type="button" class="btn btn-outline sample-btn" @onclick="() => UseSampleAsync(false)" disabled="@busy">
            Use sample CSV
        </button>
        <button type="button" class="btn btn-outline sample-btn" @onclick="() => UseSampleAsync(true)" disabled="@busy">
            Sample with cash
        </button>
        <button type="button" class="btn btn-outline sample-btn" @onclick='() => UseSampleFileAsync("sample-transactions-clean.csv")' disabled="@busy">
            Clean sample
        </button>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <p class="banner banner-error" role="alert">@error</p>
        }
    </section>
}
else
{
    <section class="hero-card">
        <p class="eyebrow">@CurrentUser.OrganizationName</p>
        <h1>Bring in your books, then ask why</h1>
        <p class="lede">
            Upload a bank export or an invoice list. Map the columns, check the rows, and see how the month is doing.
            Then ask why, with those rows in front of you.
        </p>

        <label class="upload-button @(busy ? "is-disabled" : null)">
            <InputFile OnChange="OnTransactionsSelected" accept=".csv,.xlsx,text/csv" disabled="@busy" />
            @(busy ? "Uploading…" : "Upload transactions")
        </label>
        <label class="upload-button @(busy ? "is-disabled" : null)">
            <InputFile OnChange="OnInvoicesSelected" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@busy" />
            @(busy ? "Uploading…" : "Upload invoices")
        </label>
        <button type="button" class="btn btn-outline sample-btn" @onclick="() => UseSampleAsync(false)" disabled="@busy">
            Use sample CSV
        </button>
        <button type="button" class="btn btn-outline sample-btn" @onclick="() => UseSampleAsync(true)" disabled="@busy">
            Sample with cash
        </button>
        <button type="button" class="btn btn-outline sample-btn" @onclick='() => UseSampleFileAsync("sample-transactions-clean.csv")' disabled="@busy">
            Clean sample
        </button>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <p class="banner banner-error" role="alert">@error</p>
        }

    </section>
}

@if (recent.Count > 0)
{
    <section class="panel">
        <header class="panel-header">
            <h2>Recent imports</h2>
            <p>@transactionCount transaction@(transactionCount == 1 ? "" : "s") saved for this business.</p>
        </header>
        <div class="table-scroll">
        <table class="data-table recent-table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Status</th>
                    <th>Rows</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in recent)
                {
                    <tr>
                        <td>@job.OriginalFileName</td>
                        <td><span class="status-pill">@job.Status</span></td>
                        <td>@(job.ImportedRowCount?.ToString() ?? "none")</td>
                        <td class="recent-links">
                            @if (job.Status == ImportStatus.Imported)
                            {
                                <a href="/health">Health</a>
                                <a href="@($"/imports/{job.Id}")">Rows</a>
                                <a href="@($"/imports/{job.Id}/map")">Remap</a>
                            }
                            else if (job.Status == ImportStatus.Mapped || job.Status == ImportStatus.Validated)
                            {
                                <a href="@($"/imports/{job.Id}/validate")">Continue validation</a>
                            }
                            else
                            {
                                <a href="@($"/imports/{job.Id}/map")">Continue mapping</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </section>
}

@code {
    private bool busy;
    private string? error;
    private IReadOnlyList<ImportJob> recent = [];
    private int transactionCount;
    private HealthSnapshot? snapshot;
    private MorningBriefLanding? briefLanding;

    protected override async Task OnInitializedAsync()
    {
        recent = await Imports.ListRecentAsync();
        transactionCount = await Imports.CountTransactionsAsync();
        snapshot = await HealthKpis.GetSnapshotAsync();
        var preference = await Briefs.GetPreferenceAsync();
        if (preference.OptedIn)
        {
            briefLanding = await Briefs.GetLandingAsync();
        }
    }

    private Task OnTransactionsSelected(InputFileChangeEventArgs args) =>
        UploadAsync(args, ImportKind.Transactions);

    private Task OnInvoicesSelected(InputFileChangeEventArgs args) =>
        UploadAsync(args, ImportKind.Invoices);

    private async Task UploadAsync(InputFileChangeEventArgs args, ImportKind kind)
    {
        busy = true;
        error = null;
        try
        {
            await using var upload = args.File.OpenReadStream(ImportService.MaxUploadBytes);
            await using var buffer = new MemoryStream();
            await upload.CopyToAsync(buffer);
            buffer.Position = 0;
            var job = await Imports.CreateFromUploadAsync(buffer, args.File.Name, buffer.Length, kind);
            Navigation.NavigateTo($"/imports/{job.Id}/map");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task UseSampleAsync(bool withCash) =>
        await UseSampleFileAsync(withCash ? "sample-transactions-with-cash.csv" : "sample-transactions.csv");

    private async Task UseSampleFileAsync(string fileName)
    {
        busy = true;
        error = null;
        try
        {
            var path = FindSampleCsv(fileName);
            if (path is null)
            {
                error = "That sample file is not available. Upload your own file instead.";
                return;
            }

            await using var upload = File.OpenRead(path);
            var job = await Imports.CreateFromUploadAsync(upload, Path.GetFileName(path), new FileInfo(path).Length);
            Navigation.NavigateTo($"/imports/{job.Id}/map");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private string? FindSampleCsv(string fileName)
    {
        var candidates = new[]
        {
            Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, "testdata", fileName)),
            Path.GetFullPath(Path.Combine(HostEnvironment.ContentRootPath, "testdata", fileName)),
            Path.GetFullPath(Path.Combine(HostEnvironment.ContentRootPath, "..", "..", "testdata", fileName)),
            Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "..", "..", "testdata", fileName))
        };

        return candidates.FirstOrDefault(File.Exists);
    }
}
