@page "/brief"
@attribute [Authorize]
@inject IMorningBriefAppService Briefs
@inject ICurrentUser CurrentUser

<PageTitle>Morning brief · Vhona AI</PageTitle>

@if (landing is null)
{
    <p>Loading…</p>
}
else if (!landing.OptedIn)
{
    <section class="hero-card">
        <p class="eyebrow">@CurrentUser.OrganizationName</p>
        <h1>The morning brief waits until you ask</h1>
        <p class="lede">
            Ask a question first. After a trusted why, Vhona offers one next step:
            send me the morning brief. Dismiss it once and it will not come back.
        </p>
        <a class="btn btn-primary" href="/why">Ask why</a>
    </section>
}
else
{
    <p class="eyebrow">@CurrentUser.OrganizationName</p>
    <MorningBriefView Landing="landing" />
}

@code {
    private MorningBriefLanding? landing;

    protected override async Task OnInitializedAsync()
    {
        landing = await Briefs.GetLandingAsync();
    }
}
