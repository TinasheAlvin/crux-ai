@page "/receipts/{AnswerId:guid}"
@attribute [Authorize]
@inject IWhyAppService Why
@inject ICurrentUser CurrentUser
@inject IAnalytics Analytics

<PageTitle>Receipt · Vhona AI</PageTitle>

@if (loading)
{
    <p>@WhyMessages.Checking</p>
}
else if (result is null)
{
    <section class="panel">
        <h1>Receipt not found</h1>
        <p class="lede">That question is not in this business, or it was never saved.</p>
        <a class="btn btn-primary" href="/why">@WhyMessages.TryAnother</a>
    </section>
}
else if (!result.Verified)
{
    <section class="panel">
        <p class="banner why-unverified" role="status">@WhyMessages.Unverified</p>
        <a class="btn btn-outline" href="/why">@WhyMessages.TryAnother</a>
    </section>
}
else
{
    <section class="panel">
        <p class="eyebrow">@CurrentUser.OrganizationName · receipt</p>
        <h1>@(ReasonTitle ?? "Cited rows")</h1>
        <blockquote class="why-prompt">@result.Question</blockquote>
        <p class="lede">@ShownRows.Count row@(ShownRows.Count == 1 ? "" : "s"). Columns: @ColumnsSummary.</p>
        <WhyReceiptTable Rows="ShownRows" />
        <TrustPrompt AnswerId="result.AnswerId" />
        <div class="actions">
            <a class="btn btn-primary" href="/why">@WhyMessages.TryAnother</a>
            <a class="btn btn-outline" href="/health">Health KPIs</a>
        </div>
    </section>
}

@code {
    [Parameter] public Guid AnswerId { get; set; }

    [SupplyParameterFromQuery(Name = "part")]
    public int? Part { get; set; }

    private bool loading = true;
    private WhyAskResult? result;

    private WhyReasonLine? SelectedReason =>
        result is not null && Part is int part && part >= 0 && part < result.Reasons.Count
            ? result.Reasons[part]
            : null;

    private string? ReasonTitle => SelectedReason?.Title;

    private IReadOnlyList<WhyCitedRow> ShownRows
    {
        get
        {
            if (result is null)
            {
                return [];
            }

            if (SelectedReason is null)
            {
                return result.CitedRows;
            }

            var ids = SelectedReason.RowIds.ToHashSet(StringComparer.Ordinal);
            return result.CitedRows.Where(row => ids.Contains(row.RowId)).ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        result = await Why.GetAsync(AnswerId);
        loading = false;
        if (result is { Verified: true })
        {
            Analytics.TrackReceiptOpen(result.AnswerId);
        }
    }

    private string ColumnsSummary =>
        result?.CitedRows.Select(row => row.Columns).FirstOrDefault(columns => !string.IsNullOrWhiteSpace(columns))
        ?? "Date, Description, Amount";
}
