@page "/imports/{ImportJobId:guid}"
@attribute [Authorize]
@inject IImportAppService Imports

<PageTitle>Imported · Vhona AI</PageTitle>

<ImportStepper Current="4" />

@if (job is null)
{
    <p>Loading…</p>
}
else
{
    <section class="panel">
        <header class="panel-header">
            <p class="eyebrow">@job.OriginalFileName</p>
            <h1>@(job.Kind == ImportKind.Invoices
                ? $"{invoices.Count} invoice{(invoices.Count == 1 ? "" : "s")} persisted"
                : $"{transactions.Count} transaction{(transactions.Count == 1 ? "" : "s")} persisted")</h1>
            <p class="lede">
                Each imported line has a stable <code>RowId</code>.
                Re-running persist on this import upserts by RowId.
            </p>
            @if (!string.IsNullOrWhiteSpace(job.ErrorSummary))
            {
                <p class="banner">@job.ErrorSummary</p>
            }
        </header>

        <div class="actions">
            <a class="btn btn-primary" href="/health">See health KPIs</a>
            <a class="btn btn-outline" href="/why">Ask why</a>
            <a class="btn btn-outline" href="@($"/imports/{ImportJobId}/map")">Remap columns</a>
            <a class="btn btn-link" href="@($"/imports/{ImportJobId}/validate")">Review rows</a>
        </div>

        @if (job.Kind == ImportKind.Invoices)
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>RowId</th>
                            <th>#</th>
                            <th>Customer</th>
                            <th>Invoice</th>
                            <th>Invoice date</th>
                            <th>Booked</th>
                            <th>Due</th>
                            <th>Amount</th>
                            <th>Amount due</th>
                            <th>Status</th>
                            <th>Paid</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in invoices)
                        {
                            <tr>
                                <td><code class="row-id">@invoice.RowId</code></td>
                                <td>@invoice.SourceRowNumber</td>
                                <td>@invoice.Customer?.Name</td>
                                <td>@invoice.Number</td>
                                <td>@invoice.InvoiceDate.ToString("dd MMM yyyy")</td>
                                <td>@(invoice.BookedDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td>@(invoice.DueDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="numeric">@invoice.Amount.ToString("C")</td>
                                <td class="numeric">@invoice.AmountDue.ToString("C")</td>
                                <td>@invoice.Status</td>
                                <td>@(invoice.PaidDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>RowId</th>
                        <th>#</th>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>Reference</th>
                        <th>Counterparty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var txn in transactions)
                    {
                        <tr>
                            <td><code class="row-id">@txn.RowId</code></td>
                            <td>@txn.SourceRowNumber</td>
                            <td>@txn.Date.ToString("dd MMM yyyy")</td>
                            <td>@txn.Description</td>
                            <td class="numeric">@txn.Amount.ToString("C")</td>
                            <td>@txn.Category</td>
                            <td>@txn.Reference</td>
                            <td>@txn.Counterparty</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    </section>
}

@code {
    [Parameter] public Guid ImportJobId { get; set; }

    private ImportJob? job;
    private IReadOnlyList<Transaction> transactions = [];
    private IReadOnlyList<Invoice> invoices = [];

    protected override async Task OnInitializedAsync()
    {
        job = await Imports.GetJobAsync(ImportJobId);
        if (job.Kind == ImportKind.Invoices)
        {
            invoices = await Imports.ListInvoicesAsync(ImportJobId);
            return;
        }

        transactions = await Imports.ListTransactionsAsync(ImportJobId);
    }
}
