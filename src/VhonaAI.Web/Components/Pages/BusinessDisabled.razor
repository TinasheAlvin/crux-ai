@page "/business-disabled"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Business disabled · Vhona AI</PageTitle>

<section class="auth-card">
    <h1>This business is disabled</h1>
    <p class="lede">Its books stay stored until a Vhona admin turns it back on or deletes it.</p>
    <form method="post" action="/auth/logout">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-primary">Sign out</button>
    </form>
</section>
