@page "/account-disabled"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Sign in disabled · Vhona AI</PageTitle>

<section class="auth-card">
    <h1>This sign in is disabled</h1>
    <p class="lede">A Vhona admin can turn it back on. Vhona will not email you about it.</p>
    <form method="post" action="/auth/logout">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-primary">Sign out</button>
    </form>
</section>
