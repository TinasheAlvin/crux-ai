@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject IConfiguration Configuration

<PageTitle>Sign in · Vhona AI</PageTitle>

<section class="auth-card">
    <h1>See a trusted why in the numbers</h1>
    @if (UseEntra)
    {
        <p class="lede">
            Sign in with your Microsoft account. The first time, you name your business.
            Signing in again does not rename it.
        </p>
        <a class="btn btn-primary btn-lg" href="@SignInHref" data-enhance-nav="false">Sign in</a>
    }
    else
    {
        <p class="lede">Look around as the demo owner.</p>

        <form method="post" action="/auth/demo-login">
            <AntiforgeryToken />
            @if (!string.IsNullOrWhiteSpace(SafeReturn))
            {
                <input type="hidden" name="returnUrl" value="@SafeReturn" />
            }
            <button type="submit" class="btn btn-primary btn-lg">Continue as demo owner</button>
        </form>

    }

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="banner banner-error" role="alert">@Error</p>
    }
</section>

@code {
    private bool UseEntra =>
        string.Equals(Configuration["Auth:Provider"], "EntraExternalId", StringComparison.OrdinalIgnoreCase);

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string? SafeReturn =>
        !string.IsNullOrWhiteSpace(ReturnUrl)
        && ReturnUrl.StartsWith('/')
        && !ReturnUrl.StartsWith("//")
        && !ReturnUrl.Contains('\\')
            ? ReturnUrl
            : null;

    private string SignInHref =>
        SafeReturn is null ? "/auth/signin" : "/auth/signin?returnUrl=" + Uri.EscapeDataString(SafeReturn);
}
