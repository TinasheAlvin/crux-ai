@inherits LayoutComponentBase
@inject IVhonaAdmin Admin
@inject ICurrentUser CurrentUser

<div class="page admin-shell">
    <div class="sidebar">
        <div class="sidebar-brand">
            <a class="wordmark" href="admin">VHONA-ai</a>
            <span class="brass-rule" aria-hidden="true"></span>
        </div>
        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />
        <nav class="flex-column nav-scrollable admin-nav">
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin" Match="NavLinkMatch.All"><span class="nav-icon nav-icon-admin" aria-hidden="true"></span> Overview</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/businesses"><span class="nav-icon nav-icon-business" aria-hidden="true"></span> Businesses</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/users"><span class="nav-icon nav-icon-team" aria-hidden="true"></span> Users</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/settings"><span class="nav-icon nav-icon-health" aria-hidden="true"></span> Defaults</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/events"><span class="nav-icon nav-icon-brief" aria-hidden="true"></span> Partner events</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/audit"><span class="nav-icon nav-icon-why" aria-hidden="true"></span> Audit</NavLink></div>
            <div class="nav-item px-3"><a class="nav-link" href="/"><span class="nav-icon nav-icon-home" aria-hidden="true"></span> Back to the app</a></div>
        </nav>
    </div>
    <main>
        <div class="top-row px-4">
            <span class="org-chip">Platform</span>
            <span class="user-chip">@CurrentUser.DisplayName</span>
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-link sign-out">Sign out</button>
            </form>
        </div>
        <article class="content px-4">
            @if (!Admin.IsAdmin)
            {
                <p class="lede">Not found.</p>
            }
            else
            {
                @Body
            }
        </article>
    </main>
</div>
