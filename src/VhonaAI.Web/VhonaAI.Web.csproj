<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\VhonaAI.Core\VhonaAI.Core.csproj" />
    <ProjectReference Include="..\VhonaAI.Application\VhonaAI.Application.csproj" />
    <ProjectReference Include="..\VhonaAI.Infrastructure\VhonaAI.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.1" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.21">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\testdata\sample-transactions.csv" Link="testdata\sample-transactions.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\sample-transactions-clean.csv" Link="testdata\sample-transactions-clean.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\sample-transactions-with-cash.csv" Link="testdata\sample-transactions-with-cash.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>vhonaai-web-local-dev</UserSecretsId>
  </PropertyGroup>

</Project>
