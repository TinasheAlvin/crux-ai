@if (Result.Verified)
{
    <a class="receipt-strip" href="@($"/receipts/{Result.AnswerId}")" aria-label="Open receipt to see cited rows">
        <p class="eyebrow">Receipt</p>
        <p class="receipt-strip-meta">@Result.CitedRows.Count RowId@(Result.CitedRows.Count == 1 ? "" : "s") · @ColumnsSummary</p>
        <div class="receipt-ids">
            @foreach (var row in Result.CitedRows)
            {
                <code class="row-id">@row.RowId</code>
            }
        </div>
        <p class="receipt-strip-hint">Tap to see the cited rows</p>
    </a>
}

@code {
    [Parameter, EditorRequired] public WhyAskResult Result { get; set; } = default!;

    private string ColumnsSummary =>
        Result.CitedRows.Select(row => row.Columns).FirstOrDefault(columns => !string.IsNullOrWhiteSpace(columns))
        ?? "Date, Description, Amount";
}
