@page "/why/{MetricName}"
@attribute [Authorize]
@inject HealthKpiService HealthKpis
@inject ICurrentUser CurrentUser

<PageTitle>Why · Crux AI</PageTitle>

@if (snapshot is null)
{
    <p>Loading…</p>
}
else if (card is null)
{
    <section class="panel">
        <h1>That KPI is not available</h1>
        <p class="lede">
            Cash stays hidden unless a balance field was mapped and has usable values.
            Other KPIs need persisted transactions.
        </p>
        <a class="btn btn-primary" href="/health">Back to health</a>
    </section>
}
else
{
    <section class="panel">
        <p class="eyebrow">@CurrentUser.OrganizationName · seeded why</p>
        <h1>@card.Kind</h1>
        <blockquote class="why-prompt">@card.WhyPrompt</blockquote>
        <p class="lede">
            This seeds the “Why did this change?” question from the KPI card.
            Azure OpenAI receipted why is out of scope for this slice — no generated answer yet.
        </p>

        <div class="why-split">
            <div>
                <h2>@snapshot.CurrentPeriod!.Label RowIds</h2>
                <ul class="row-id-list">
                    @if (card.CurrentRowIds.Count == 0)
                    {
                        <li>None</li>
                    }
                    else
                    {
                        @foreach (var id in card.CurrentRowIds)
                        {
                            <li><code class="row-id">@id</code></li>
                        }
                    }
                </ul>
            </div>
            <div>
                <h2>@snapshot.PreviousPeriod!.Label RowIds</h2>
                <ul class="row-id-list">
                    @if (card.PreviousRowIds.Count == 0)
                    {
                        <li>None</li>
                    }
                    else
                    {
                        @foreach (var id in card.PreviousRowIds)
                        {
                            <li><code class="row-id">@id</code></li>
                        }
                    }
                </ul>
            </div>
        </div>

        <div class="actions">
            <a class="btn btn-primary" href="/health">Back to health</a>
            @if (snapshot.LatestImportJobId is Guid importId)
            {
                <a class="btn btn-outline" href="@($"/imports/{importId}/map")">Remap columns</a>
            }
        </div>
    </section>
}

@code {
    [Parameter] public string MetricName { get; set; } = "";

    private HealthSnapshot? snapshot;
    private MetricCard? card;

    protected override async Task OnInitializedAsync()
    {
        snapshot = await HealthKpis.GetSnapshotAsync();
        if (Enum.TryParse<HealthMetricKind>(MetricName, ignoreCase: true, out var kind))
        {
            card = snapshot.Card(kind);
        }
    }
}
