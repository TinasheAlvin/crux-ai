@page "/receipts/{AnswerId:guid}"
@attribute [Authorize]
@inject WhyService Why
@inject ICurrentUser CurrentUser

<PageTitle>Receipt · Crux AI</PageTitle>

@if (loading)
{
    <p>Loading…</p>
}
else if (result is null)
{
    <section class="panel">
        <h1>Receipt not found</h1>
        <p class="lede">That Q&amp;A is not in this organisation, or it was never logged.</p>
        <a class="btn btn-primary" href="/why">Ask why</a>
    </section>
}
else if (!result.Verified)
{
    <section class="panel">
        <p class="eyebrow">@CurrentUser.OrganizationName · receipt</p>
        <h1>No cited rows</h1>
        <p class="banner why-unverified" role="status">@WhyMessages.Unverified</p>
        <p class="hint">Try another question, or tap a KPI card for a seeded why with period context.</p>
        <a class="btn btn-primary" href="/why">Try another question</a>
    </section>
}
else
{
    <section class="panel">
        <p class="eyebrow">@CurrentUser.OrganizationName · receipt</p>
        <h1>Cited transaction rows</h1>
        <blockquote class="why-prompt">@result.Question</blockquote>
        <pre class="why-answer-body">@result.Answer</pre>
        <p class="lede">
            @result.CitedRows.Count RowId@(result.CitedRows.Count == 1 ? "" : "s") ·
            columns @ColumnsSummary.
        </p>
        <WhyReceiptTable Rows="result.CitedRows" />
        <div class="actions">
            <a class="btn btn-primary" href="/why">Ask another why</a>
            <a class="btn btn-outline" href="/health">Health KPIs</a>
        </div>
    </section>
}

@code {
    [Parameter] public Guid AnswerId { get; set; }

    private bool loading = true;
    private WhyAskResult? result;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        result = await Why.GetAsync(AnswerId);
        loading = false;
    }

    private string ColumnsSummary =>
        result?.CitedRows.Select(row => row.Columns).FirstOrDefault(columns => !string.IsNullOrWhiteSpace(columns))
        ?? "Date, Description, Amount";
}
